<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/corFundo"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/marketplace_titulo"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="@color/corTextoPrimario" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/marketplace_subtitulo"
        android:textColor="@color/corTextoSecundario" />

    <ListView
        android:id="@+id/listPsicologos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/corTextoSecundario"
        android:dividerHeight="1dp" />

</LinearLayout>
